# ============================================================================
# Configuration de la plateforme (copier en .env : cp .env.example .env)
# ============================================================================

# --- Base de données -------------------------------------------------------
DB_HOST=localhost          # en Docker, surchargé à "postgres" par compose
DB_PORT=5432
DB_NAME=telecom_db
DB_USER=telecom_user
DB_PASSWORD=telecom_password
DB_SSL_MODE=prefer
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=data/logs/pipeline.log
LOG_FORMAT=json            # json | text

# --- Collecte (résilience) -------------------------------------------------
REQUEST_TIMEOUT=180
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_FACTOR=2
RETRY_BACKOFF_MAX=120

# --- Sources activées ------------------------------------------------------
ENABLE_TRUSTPILOT=true
ENABLE_PLAYSTORE=true
ENABLE_APPSTORE=true
ENABLE_GOOGLEMAPS=false
ENABLE_RSS_FEED=true

TRUSTPILOT_CACHE_PATH=data/state/tp_state.json
TRUSTPILOT_MAX_PAGES=10
APPSTORE_MAX_PAGES=5
APPSTORE_FALLBACK_COUNTRY=fr
GOOGLEMAPS_MAX_REVIEWS=300
GOOGLEMAPS_HEADLESS=true

# --- Planification (worker) ------------------------------------------------
ENABLE_SCHEDULER=true
SCHEDULER_INTERVAL_MINUTES=60    # fréquence de collecte
SCHEDULER_RUN_ON_START=true      # exécuter un run dès le démarrage
SCHEDULER_TIMEZONE=Africa/Casablanca

# --- Alerting --------------------------------------------------------------
ENABLE_MONITORING=true
ALERT_ZERO_REVIEWS=true
ALERT_NEGATIVE_RATIO=0.5         # seuil de pic de négatif (0-1)
ALERT_MIN_REVIEWS_FOR_RATIO=10   # nb min d'avis avant d'évaluer le ratio

# E-mail (laisser SMTP_HOST vide pour désactiver le canal e-mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL=

# Webhook Slack/Discord/Teams (laisser vide pour désactiver)
ALERT_WEBHOOK_URL=

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=*               # CSV des origines autorisées (dashboard)
